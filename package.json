{
  "name": "ideahub",
  "displayName": "创意仓库 / IdeaHub",
  "description": "Your Ideas. Your History. Your Proof.",
  "version": "0.1.0",
  "publisher": "ideahub-dev",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:ideahub.main"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideahub",
          "title": "创意仓库",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "ideahub": [
        {
          "type": "webview",
          "id": "ideahub.main",
          "name": "创意仓库"
        }
      ]
    },
    "commands": [
      {
        "command": "ideahub.refresh",
        "title": "创意仓库: 刷新状态"
      },
      {
        "command": "ideahub.openMain",
        "title": "创意仓库: 打开主界面"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "pnpm run build && npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
