{
  "name": "ideahub-vscode",
  "displayName": "%ideahub.displayName%",
  "description": "%ideahub.description%",
  "version": "1.1.2",
  "publisher": "ideahub",
  "license": "MIT",
  "icon": "icon.png",
  "private": true,
  "keywords": [
    "ideahub",
    "idea",
    "proof",
    "timestamp",
    "git",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phphe/ideahub.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/phphe/ideahub#readme",
  "bugs": {
    "url": "https://github.com/phphe/ideahub/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onView:ideahub.main"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideahub",
          "title": "%ideahub.viewContainerTitle%",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "ideahub": [
        {
          "type": "webview",
          "id": "ideahub.main",
          "name": "%ideahub.viewName%"
        }
      ]
    },
    "commands": [
      {
        "command": "ideahub.refresh",
        "title": "%ideahub.command.refresh%"
      },
      {
        "command": "ideahub.openMain",
        "title": "%ideahub.command.openMain%"
      }
    ],
    "configuration": {
      "title": "%ideahub.configuration.title%",
      "properties": {
        "ideahub.proof.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "%ideahub.configuration.proofAutoCommit.description%"
        },
        "ideahub.proof.commitMessage": {
          "type": "string",
          "default": "ideahub: record proof",
          "description": "%ideahub.configuration.proofCommitMessage.description%"
        },
        "ideahub.publish.commitMessage": {
          "type": "string",
          "default": "ideahub: mark published",
          "description": "%ideahub.configuration.publishCommitMessage.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@ideahub/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "0.0.46-24",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
