{
  "name": "@ideahub/cli",
  "version": "1.1.0",
  "description": "Command line tool that verifies IdeaHub proofs of when an idea was created.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ideahub",
    "idea",
    "proof",
    "timestamp",
    "verification",
    "github",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phphe/ideahub.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/phphe/ideahub#readme",
  "bugs": {
    "url": "https://github.com/phphe/ideahub/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ideahub": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ideahub/core": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
